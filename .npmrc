# Determinism comes from package-lock.json, not from freezing package.json
# ranges. Exact pins previously froze five dependencies at vulnerable floors
# (vitest 3.2.4, playwright 1.55.0, postcss 8.5.6, vite 7.1.5,
# react-router-dom 7.9.1) — see BUILD_RESULTS.txt section 15.
#
# save-exact is deliberately NOT set: it would reintroduce that failure mode
# the next time anyone runs `npm install <pkg>`.

engine-strict=true

# Reproducible installs: use `npm ci` in CI, which installs strictly from the
# lockfile and fails if package.json and the lockfile disagree.
