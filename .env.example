# Copy to .env.local and fill in from the Supabase dashboard:
#   Project Settings → API
#
# Both values are safe to expose in the browser. VITE_* variables are inlined
# into the JavaScript bundle at build time and are readable by anyone who
# loads the site — that is expected for these two, and is exactly why the
# service-role / secret key must never be placed here. The app refuses to
# start if it detects one in the publishable slot.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
